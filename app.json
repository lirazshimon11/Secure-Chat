{
  "expo": {
    "name": "Private Chat",
    "slug": "private-chat-antiavi",
    "version": "1.0.0",
    "orientation": "portrait",
    "userInterfaceStyle": "automatic",
    "icon": "./public/images/icon.png",
    "assetBundlePatterns": [
      "**/*"
    ],
    "ios": {
      "supportsTablet": false,
      "bundleIdentifier": "com.privatechat.antiavi"
    },
    "android": {
      "package": "com.privatechat.antiavi",
      "adaptiveIcon": {
        "foregroundImage": "./public/images/icon.png",
        "backgroundColor": "#f4efe6"
      }
    },
    "web": {
      "favicon": "./public/images/icon.png"
    },
    "plugins": [
      "expo-secure-store"
    ],
    "extra": {
      "eas": {
        "projectId": "replace-me"
      }
    }
  }
}
