{
  "expo": {
    "name": "SecureApp",
    "slug": "secure-app",
    "version": "1.0.0",
    "orientation": "portrait",
    "userInterfaceStyle": "automatic",
    "icon": "./public/images/icon2.png",
    "assetBundlePatterns": [
      "**/*"
    ],
    "ios": {
      "supportsTablet": false,
      "bundleIdentifier": "com.secureapp.app"
    },
    "android": {
      "package": "com.secureapp.app",
      "softwareKeyboardLayoutMode": "resize",
      "adaptiveIcon": {
        "foregroundImage": "./public/images/icon2.png",
        "backgroundColor": "#f4efe6"
      }
    },
    "web": {
      "favicon": "./public/images/icon2.png"
    },
    "plugins": [
      "expo-secure-store",
      "@react-native-community/datetimepicker"
    ],
    "extra": {
      "eas": {
        "projectId": "0b85e461-e09c-49da-a6e7-28b5f9e0268c"
      }
    }
  }
}